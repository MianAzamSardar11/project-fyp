RewriteEngine On

# Hide .php extension (but exclude files with extensions like .css, .js, .jpg, etc.)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.(css|js|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot|pdf|zip|tar|gz)$ [NC]
RewriteRule ^([^/]+)/?$ $1.php [L]

# Redirect .php requests to clean URLs (optional)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# Custom 404 Error Page
ErrorDocument 404 /404.php
